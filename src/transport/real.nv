module http.transport

import std.net.{TcpStream, resolve}
import tls.{TlsStream, ClientConfig, TlsError}
import http.{Http, HttpError, ErrorKind, HttpConfig}
import http.client.{ResponseFramer}

/// Native single-hop HTTP/HTTPS transport. The same byte framer as the client
/// stops reads at completion (not EOF), validates framing, and bounds storage.
#stable(since = "0.1")
export fn real_http() -> Effect[Http] => effect Http {
    send(host, port, secure, request, config) -> Result[[]u8, HttpError] {
        send_bounded(host, port, secure, request, config)
    }
}

fn send_bounded(host str, port int, secure bool, request []u8, config HttpConfig) Net Time -> Result[[]u8, HttpError] {
    config.check_timeouts()?
    ro end = match config.deadline {
        Some(d) => d
        None => Monotonic.now() + config.total_timeout
    }
    mut response Result[[]u8, HttpError] = Err(HttpError.new(ErrorKind.Canceled))
    ro status = with Fail[TimeoutError] = |_e| 0 {
        ro result = supervised(cancel: config.cancel) {
            supervised(deadline: end) {
                response = send_once(host, port, secure, request, config)
            }
        }
        match result { Finished(_) => 1, Aborted(_) => 2 }
    }
    // Direct native waits may return their typed Cancelled error instead of
    // throwing. The absolute clock check is authoritative after the wait has
    // actually been interrupted; preserve the original transport source.
    if status == 0 || Monotonic.now().compare(end) >= 0 {
        return interrupted_result(response, ErrorKind.Timeout)
    }
    if status == 2 { return interrupted_result(response, ErrorKind.Canceled) }
    match response {
        Err(e) => if transport_cancelled(e) {
            interrupted_result(Err(e), if config.cancel.is_cancelled() { ErrorKind.Canceled } else { ErrorKind.Timeout })
        } else { Err(e) }
        Ok(b) => Ok(b)
    }
}

fn transport_cancelled(e HttpError) -> bool {
    match e.source {
        Some(Net(ne)) => match ne { Cancelled => true, _ => false }
        Some(Tls(te)) => match te { Net(ne) => match ne { Cancelled => true, _ => false }, _ => false }
        _ => false
    }
}

fn interrupted_result(response Result[[]u8, HttpError], kind ErrorKind) -> Result[[]u8, HttpError] {
    match response {
        Err(e) => Err(HttpError { kind, url: e.url, source: e.source })
        Ok(_) => Err(HttpError.new(kind))
    }
}

fn send_once(host str, port int, secure bool, request []u8, config HttpConfig) Net -> Result[[]u8, HttpError] {
    if secure { https_send_over_net(host, port, request, config) }
    else { http_send_over_net(host, port, request, config) }
}

fn connect_tcp(host str, port int, config HttpConfig) Net -> Result[TcpStream, HttpError] {
    ro (tx, rx) = Channel[Result[TcpStream, HttpError]].new(1)
    supervised(timeout: config.connect_timeout) {
        ro sent = tx.try_send(connect_tcp_now(host, port))
        assert(sent)
    }
    tx.close()
    match rx.try_recv() {
        Some(consume r) => r
        None => Err(HttpError.new(ErrorKind.Canceled))
    }
}

fn connect_tcp_now(host str, port int) Net -> Result[TcpStream, HttpError] {
    ro addrs = match resolve(host, port) {
        Ok(a) => a
        Err(e) => return Err(HttpError.from_net(ErrorKind.Dns, e))
    }
    mut last = HttpError.transport(ErrorKind.Dns, "no addresses resolved")
    for addr in addrs {
        match TcpStream.connect(addr) {
            Ok(consume s) => return Ok(s)
            Err(e) => {
                last = HttpError.from_net(ErrorKind.Connect, e)
                if transport_cancelled(last) { return Err(last) }
            }
        }
    }
    Err(last)
}

fn tls_connect_now(host str, port int, cfg ClientConfig) Net -> Result[TlsStream, HttpError] {
    match connect_tcp_now(host, port) {
        Ok(consume s) => match TlsStream.connect(s, cfg) {
            Ok(consume t) => Ok(t)
            Err(e) => Err(HttpError.from_tls(ErrorKind.Tls, e))
        }
        Err(e) => Err(e)
    }
}

fn tls_connect_bounded(host str, port int, cfg ClientConfig, config HttpConfig) Net -> Result[TlsStream, HttpError] {
    ro (tx, rx) = Channel[Result[TlsStream, HttpError]].new(1)
    supervised(timeout: config.connect_timeout) {
        ro sent = tx.try_send(tls_connect_now(host, port, cfg))
        assert(sent)
    }
    tx.close()
    match rx.try_recv() {
        Some(consume r) => r
        None => Err(HttpError.new(ErrorKind.Canceled))
    }
}

fn request_is_head(request []u8) -> bool {
    request.len() >= 5 && request[0] == 72 as u8 && request[1] == 69 as u8 &&
    request[2] == 65 as u8 && request[3] == 68 as u8 && request[4] == 32 as u8
}

fn http_send_over_net(host str, port int, request []u8, config HttpConfig) Net -> Result[[]u8, HttpError] {
    consume stream = match connect_tcp(host, port, config) {
        Ok(consume s) => s
        Err(e) => return Err(e)
    }
    ro result = http_exchange(stream, request, config)
    stream.close()
    result
}

fn http_exchange(mut stream TcpStream, request []u8, config HttpConfig) Net -> Result[[]u8, HttpError] {
    match stream.write_all(request) {
        Ok(_) => ()
        // A failed WRITE is a broken/closed connection, not a connect failure —
        // mislabeling it Connect masked the real phase in acceptance matrices.
        Err(e) => return Err(HttpError.from_net(ErrorKind.Closed, e))
    }
    mut frame = ResponseFramer.new(request_is_head(request), config.header_bytes, config.encoded_body_bytes, config.decoded_body_bytes)
    while !frame.complete() {
        match stream.read_bytes(4096) {
            Ok(bytes) => {
                if bytes.len() == 0 { frame.finish_eof()? } else { frame.feed(bytes)? }
            }
            Err(e) => return Err(HttpError.from_net(ErrorKind.Closed, e))
        }
    }
    Ok(frame.bytes())
}

fn https_send_over_net(host str, port int, request []u8, config HttpConfig) Net -> Result[[]u8, HttpError] {
    ro base = match config.tls { Some(c) => c, None => ClientConfig.new(host) }
    // Bind verification/SNI to the actual destination, not the previous hop.
    ro cfg = ClientConfig {
        server_name: host, alpn_protocols: ["http/1.1"], verification: base.verification,
        client_cert_pem: base.client_cert_pem, client_key_pem: base.client_key_pem,
        proxy: base.proxy, trust_digest: base.trust_digest
    }
    consume stream = match tls_connect_bounded(host, port, cfg, config) {
        Ok(consume s) => s
        Err(e) => return Err(e)
    }
    ro result = https_exchange(stream, request, config)
    stream.close()
    result
}

fn https_exchange(mut stream TlsStream, request []u8, config HttpConfig) Net -> Result[[]u8, HttpError] {
    match stream.write_all(request) {
        Ok(_) => ()
        Err(e) => return Err(HttpError.from_tls(ErrorKind.Tls, e))
    }
    mut frame = ResponseFramer.new(request_is_head(request), config.header_bytes, config.encoded_body_bytes, config.decoded_body_bytes)
    while !frame.complete() {
        match stream.read_bytes(4096) {
            Ok(bytes) => {
                if bytes.len() == 0 { frame.finish_eof()? } else { frame.feed(bytes)? }
            }
            Err(e) => return Err(HttpError.from_tls(ErrorKind.Tls, e))
        }
    }
    Ok(frame.bytes())
}
