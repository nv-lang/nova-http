// SPDX-License-Identifier: MIT OR Apache-2.0
module http

import tls.{ClientConfig}
import std.time.duration

/// One policy shared by the client codec and native transport. Byte limits are
/// finite, nonnegative. total_timeout is resolved ONCE for the redirect chain;
/// deadline is an optional earlier absolute deadline. connect_timeout bounds
/// DNS/connect/TLS handshake. Cancellation uses the runtime supervised scope.
export type HttpConfig {
    header_bytes int
    encoded_body_bytes int
    decoded_body_bytes int
    connect_timeout Duration
    total_timeout Duration
    deadline Option[Monotonic]
    cancel CancelToken
    tls Option[ClientConfig]
}

export fn HttpConfig.new() -> HttpConfig => {
    header_bytes: 65536, encoded_body_bytes: 67108864, decoded_body_bytes: 67108864,
    connect_timeout: 10.to_seconds(), total_timeout: 30.to_seconds(),
    deadline: None, cancel: CancelToken.new(), tls: None
}

/// connect_ms/total_ms must be 1..2147483647 (service-binding contract,
/// production-rework п.2: total включает ожидание в очереди, поэтому ноль и
/// переполнение i32-ms недопустимы). Значение вне диапазона отклоняется
/// функцией ниже; вызывается в `into_client` и в transport `send_bounded`.
export fn HttpConfig @check_timeouts() -> Result[(), HttpError] {
    ro connect_ms = @connect_timeout.millis()
    if connect_ms < 1 || connect_ms > 2147483647 {
        return Err(HttpError.protocol_error("connect_timeout ms out of range 1..2147483647"))
    }
    ro total_ms = @total_timeout.millis()
    if total_ms < 1 || total_ms > 2147483647 {
        return Err(HttpError.protocol_error("total_timeout ms out of range 1..2147483647"))
    }
    Ok(())
}

/// Byte-native single-hop HTTP/1 exchange; payload is never an unchecked str.
/// Custom handlers must preserve errors and deliver a complete framed response.
#stable(since = "0.1")
export type Http effect {
    send(host str, port int, secure bool, request []u8, config HttpConfig) -> Result[[]u8, HttpError]
}
